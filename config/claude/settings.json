{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(git pull:*)",
      "Bash(gh release create:*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "::1"
      ],
      "allowLocalBinding": true
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark"
}
